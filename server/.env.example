# Telegram Bot Token — получить у @BotFather
BOT_TOKEN=123456:ABC-DEF

# ID группы поваров (отрицательное число для групп)
COOKS_CHAT_ID=-1001234567890

# URL развёрнутого WebApp (для ReplyKeyboard / MenuButton)
WEBAPP_URL=https://your-app.example.com

# Порт сервера
PORT=3000

# SQLite (по умолчанию)
DATABASE_URL="file:./dev.db"

# Максимальный возраст initData в секундах (защита от replay-атак)
# По умолчанию 86400 (24 часа). Увеличьте если пользователи жалуются на истечение сессии
AUTH_MAX_AGE_SEC=86400

# Разрешённый CORS-домен (фронтенд URL)
ALLOWED_ORIGIN=https://your-app.example.com
